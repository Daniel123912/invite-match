# PostgreSQL
DATABASE_URL=postgresql+psycopg2://fsp:fsp@localhost:5432/fsp_talent_db

# Локальная разработка: DEBUG=true. В проде — false и сильный SECRET_KEY (≥32).
DEBUG=true
SECRET_KEY=replace-with-unique-secret-at-least-32-chars
# Только локально без SMTP (в проде должно быть false / не задавать)
EXPOSE_EMAIL_CONFIRM_TOKEN=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Не задавать в проде. Пример только для preview-стенда команды:
# CORS_ORIGIN_REGEX=

# Демо-учётки при seed (в проде — false)
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=demo1234
